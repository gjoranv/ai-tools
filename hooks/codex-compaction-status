#!/usr/bin/env python3
"""Report the selected Codex session's compaction count from Codex hooks."""

import json
from pathlib import Path
import subprocess
import sys


COMMAND = Path(__file__).resolve().parents[1] / "bin" / "codex-compactions"
STATUS_SYMBOLS = {"green": "🟢", "yellow": "🟡", "red": "🔴"}


def main() -> int:
    try:
        event = json.load(sys.stdin)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return 0

    if not isinstance(event, dict):
        return 0
    event_name = event.get("hook_event_name")
    if event_name != "PostCompact" and not (
        event_name == "SessionStart" and event.get("source") == "resume"
    ):
        return 0
    # Subagent events carry the parent's session ID, so that count is unrelated.
    if event.get("agent_id") is not None or event.get("agent_type") is not None:
        return 0
    session_id = event.get("session_id")
    if not isinstance(session_id, str) or not session_id:
        return 0

    try:
        result = subprocess.run(
            [str(COMMAND), "--session", session_id, "--json"],
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if result.returncode:
        return 0

    try:
        report = json.loads(result.stdout)
        count = report["compactions"]
        status = report["range"]
        ranges = report["ranges"]
        if (
            report["session_id"] != session_id
            or type(count) is not int
            or status not in ranges
        ):
            return 0
        noun = "compaction" if count == 1 else "compactions"
        status_line = (
            f"{STATUS_SYMBOLS[status]} {count} {noun} for this session, "
            f"{status.upper()} range ({ranges[status]})"
        )
        if status == "green":
            message = f"\n{status_line}"
        else:
            message = (
                "\n── Compaction status ──\n"
                f"{status_line}\n"
                f"{report['guidance']}\n"
                "───────────────────────"
            )
    except (KeyError, TypeError, ValueError):
        return 0

    print(json.dumps({"systemMessage": message}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
